# =============================================================================
# 🚀 Backend Production Dockerfile
# =============================================================================
# Security: Non-root user, minimal image, no devDependencies
# Size:     ~120MB (vs ~250MB development image)
# =============================================================================

# ─── Stage 1: Install Dependencies ──────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Copy package files only (memanfaatkan Docker layer cache)
COPY package*.json ./

# Install production dependencies only (tanpa devDependencies seperti nodemon)
RUN npm ci --omit=dev && npm cache clean --force

# ─── Stage 2: Production Image ──────────────────────────────────────────────
FROM node:20-alpine AS runner

# Security: Tambah label metadata
LABEL maintainer="andrel"
LABEL description="Finance Tracker API - Production"

# Security: Install dumb-init untuk proper signal handling (PID 1 problem)
RUN apk add --no-cache dumb-init wget

# Security: Buat non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser  -u 1001 -S appuser -G appgroup

WORKDIR /app

# Copy dependencies dari stage 1
COPY --from=deps --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy application code
COPY --chown=appuser:appgroup . .

# Set environment
ENV NODE_ENV=production
ENV PORT=3011

# Expose port
EXPOSE 3011

# Switch ke non-root user
USER appuser

# Health check inside container
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3011/api/health || exit 1

# Gunakan dumb-init untuk handle signals dengan benar
# (agar SIGTERM dari Docker bisa diterima Node.js, bukan di-ignore)
ENTRYPOINT ["dumb-init", "--"]

# Production: gunakan 'node' langsung (bukan nodemon)
CMD ["node", "app.js"]
