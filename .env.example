# ──────────────────────────────────────
# Finance Tracker — Environment Variables
# ──────────────────────────────────────
# Copy this file:  cp .env.example .env
# Then modify values as needed.

# ──────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=db_transaksi
DATABASE_URL=postgresql://admin:password123@db:5432/db_transaksi

# ──────────────────────────────────────
# Backend (Express)
# ──────────────────────────────────────
PORT=3011
NODE_ENV=development

# ──────────────────────────────────────
# Redis (Rate Limiting & Account Lockout)
# ──────────────────────────────────────
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────
# Auth (JWT)
# ──────────────────────────────────────
# ⚠️ GANTI di production! Generate: openssl rand -base64 64
JWT_SECRET=dev-secret-change-in-production

# ──────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3011/api
