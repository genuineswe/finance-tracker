# =============================================================================
# 🔒 Finance Tracker — Production Environment Variables
# =============================================================================
# JANGAN commit file .env.production yang sudah diisi!
# Gunakan file ini sebagai template:  cp .env.production.example .env.production
#
# Di AWS, sebaiknya gunakan:
#   → AWS SSM Parameter Store (gratis)
#   → AWS Secrets Manager (berbayar, auto-rotate)
# =============================================================================

# ──────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────
# ⚠️ GANTI password dengan password yang kuat (min. 32 karakter, random)
# Generate: openssl rand -base64 32
POSTGRES_USER=finance_prod_user
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
POSTGRES_DB=finance_tracker_prod
DATABASE_URL=postgresql://finance_prod_user:CHANGE_ME_USE_OPENSSL_RAND_BASE64_32@db:5432/finance_tracker_prod

# ──────────────────────────────────────
# Backend (Express)
# ──────────────────────────────────────
BACKEND_PORT=3011
NODE_ENV=production

# ──────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────
# Ganti dengan domain production Anda
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
