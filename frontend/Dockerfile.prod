# =============================================================================
# 🚀 Frontend Production Dockerfile (Multi-Stage)
# =============================================================================
# 3 Stage Build:
#   1. deps    → Install dependencies
#   2. builder → Build Next.js (npm run build)
#   3. runner  → Production image (~100MB)
# =============================================================================

# ─── Stage 1: Install Dependencies ──────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

# ─── Stage 2: Build Next.js ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set build-time environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build the Next.js application
RUN npm run build

# ─── Stage 3: Production Runner ─────────────────────────────────────────────
FROM node:20-alpine AS runner

LABEL maintainer="andrel"
LABEL description="Finance Tracker Frontend - Production"

# Install dumb-init dan wget (untuk healthcheck)
RUN apk add --no-cache dumb-init wget

# Buat non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser  -u 1001 -S appuser -G appgroup

WORKDIR /app

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3010
ENV HOSTNAME="0.0.0.0"

# Copy built application dari builder stage
# Next.js standalone output (jika dikonfigurasi di next.config)
COPY --from=builder --chown=appuser:appgroup /app/.next ./.next
COPY --from=builder --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /app/package.json ./package.json
COPY --from=builder --chown=appuser:appgroup /app/public ./public 2>/dev/null || true

EXPOSE 3010

# Switch to non-root user
USER appuser

# Health Check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3010/ || exit 1

ENTRYPOINT ["dumb-init", "--"]

# Start Next.js production server
CMD ["npx", "next", "start", "-p", "3010", "-H", "0.0.0.0"]
